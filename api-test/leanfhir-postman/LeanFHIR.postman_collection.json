    {
      "name": "02-read-update",
      "description": "Read (F1); update with If-Match current and stale (F4).",
      "item": [
        {
          "name": "Read Patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Patient/{{patientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Patient",
                "{{patientId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"resourceType Patient\", () => pm.expect(pm.response.json().resourceType).to.eql(\"Patient\"));",
                  "const body = pm.response.json();",
                  "pm.test(\"id matches\", () => pm.expect(body.id).to.eql(pm.collectionVariables.get(\"patientId\")));",
                  "pm.test(\"birthDate\", () => pm.expect(body.birthDate).to.eql(\"1980-05-17\"));",
                  "pm.test(\"content type is FHIR JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/fhir+json\"));",
                  "pm.test(\"ETag and Last-Modified are present\", () => {",
                  "  pm.expect(pm.response.headers.get(\"ETag\")).to.eql('W/\"1\"');",
                  "  pm.expect(pm.response.headers.get(\"Last-Modified\")).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "id": "65255e9d-ef29-599b-bcd0-3a63467b41bc"
        },
        {
          "name": "Update Patient (If-Match current)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/fhir+json"
              },
              {
                "key": "If-Match",
                "value": "W/\"1\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Patient/{{patientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Patient",
                "{{patientId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Patient\",\n  \"identifier\": [\n    {\n      \"system\": \"urn:leanfhir:test:mrn\",\n      \"value\": \"MRN-{{runId}}\"\n    }\n  ],\n  \"active\": true,\n  \"name\": [\n    {\n      \"family\": \"Smithson\",\n      \"given\": [\n        \"Jane\",\n        \"Marie\"\n      ]\n    }\n  ],\n  \"gender\": \"female\",\n  \"birthDate\": \"1980-05-17\",\n  \"managingOrganization\": {\n    \"reference\": \"Organization/{{orgId}}\"\n  },\n  \"generalPractitioner\": [\n    {\n      \"reference\": \"Practitioner/{{practitionerId}}\"\n    }\n  ],\n  \"id\": \"{{patientId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"resourceType Patient\", () => pm.expect(pm.response.json().resourceType).to.eql(\"Patient\"));",
                  "pm.test(\"meta.versionId is \\\"2\\\"\", () => pm.expect(pm.response.json().meta.versionId).to.eql(\"2\"));",
                  "pm.test(\"ETag is W/\\\"2\\\"\", () => pm.expect(pm.response.headers.get(\"ETag\")).to.eql('W/\"2\"'));"
                ]
              }
            }
          ],
          "id": "443945e7-7047-5c22-8a06-0085d8666fe5"
        },
