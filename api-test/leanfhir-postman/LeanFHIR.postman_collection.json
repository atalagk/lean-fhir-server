        {
          "name": "CapabilityStatement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metadata",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metadata"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"resourceType CapabilityStatement\", () => pm.expect(pm.response.json().resourceType).to.eql(\"CapabilityStatement\"));",
                  "const cs = pm.response.json();",
                  "pm.test(\"fhirVersion 4.0.1\", () => pm.expect(cs.fhirVersion).to.eql(\"4.0.1\"));",
                  "pm.test(\"lists exactly the six supported types\", () => {",
                  "  const types = cs.rest[0].resource.map((r) => r.type).sort();",
                  "  pm.expect(types).to.eql([\"Encounter\", \"Location\", \"Organization\", \"Patient\", \"Practitioner\", \"PractitionerRole\"]);",
                  "});"
                ]
              }
            }
          ],
          "id": "08de6664-4cf7-58b6-a8b0-e5b0b7b8c256"
        }
      ],
      "id": "439aae72-fd63-5fa0-8e4e-ae542bd41e00"
    },
    {
      "name": "01-create",
      "description": "Create all six types in reference order (F2, F11). Sets runId and the id variables.",
      "item": [
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/fhir+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Organization",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Organization"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Organization\",\n  \"identifier\": [\n    {\n      \"system\": \"urn:leanfhir:test:org\",\n      \"value\": \"ORG-{{runId}}\"\n    }\n  ],\n  \"active\": true,\n  \"name\": \"Test Clinic {{runId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New run id per run: keeps identifiers unique so data from earlier runs",
                  "// does not affect the conditional-create and search checks.",
                  "pm.collectionVariables.set(\"runId\", String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"resourceType Organization\", () => pm.expect(pm.response.json().resourceType).to.eql(\"Organization\"));",
                  "const body = pm.response.json();",
                  "pm.test(\"meta.versionId is \\\"1\\\"\", () => pm.expect(body.meta.versionId).to.eql(\"1\"));",
                  "pm.test(\"ETag is W/\\\"1\\\"\", () => pm.expect(pm.response.headers.get(\"ETag\")).to.eql('W/\"1\"'));",
                  "pm.test(\"Location points at the new resource\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/Organization/\" + body.id));",
                  "pm.collectionVariables.set(\"orgId\", body.id);"
                ]
              }
            }
          ],
          "id": "ec73212a-745d-5b56-955b-250789b91fba"
        },
