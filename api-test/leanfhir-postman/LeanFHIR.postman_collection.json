    {
      "name": "03-search",
      "description": "Token, string, date and reference search; unknown parameter gives 400 (F6).",
      "item": [
        {
          "name": "Patient by identifier (token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Patient?identifier=urn:leanfhir:test:mrn|MRN-{{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Patient"
              ],
              "query": [
                {
                  "key": "identifier",
                  "value": "urn:leanfhir:test:mrn|MRN-{{runId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"resourceType Bundle\", () => pm.expect(pm.response.json().resourceType).to.eql(\"Bundle\"));",
                  "const b = pm.response.json();",
                  "pm.test(\"searchset with one match\", () => {",
                  "  pm.expect(b.type).to.eql(\"searchset\");",
                  "  pm.expect(b.total).to.eql(1);",
                  "  pm.expect(b.entry[0].resource.id).to.eql(pm.collectionVariables.get(\"patientId\"));",
                  "  pm.expect(b.entry[0].search.mode).to.eql(\"match\");",
                  "});"
                ]
              }
            }
          ],
          "id": "2108b3bc-f21a-5a66-8e52-2deb645e8297"
        },
        {
          "name": "Patient by family (string, starts-with, case-insensitive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Patient?family=smi&_count=200",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Patient"
              ],
              "query": [
                {
                  "key": "family",
                  "value": "smi"
                },
                {
                  "key": "_count",
                  "value": "200"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
