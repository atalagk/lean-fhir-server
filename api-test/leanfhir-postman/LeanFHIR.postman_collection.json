        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/fhir+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Patient",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Patient"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Patient\",\n  \"identifier\": [\n    {\n      \"system\": \"urn:leanfhir:test:mrn\",\n      \"value\": \"MRN-{{runId}}\"\n    }\n  ],\n  \"active\": true,\n  \"name\": [\n    {\n      \"family\": \"Smithson\",\n      \"given\": [\n        \"Jane\"\n      ]\n    }\n  ],\n  \"gender\": \"female\",\n  \"birthDate\": \"1980-05-17\",\n  \"managingOrganization\": {\n    \"reference\": \"Organization/{{orgId}}\"\n  },\n  \"generalPractitioner\": [\n    {\n      \"reference\": \"Practitioner/{{practitionerId}}\"\n    }\n  ],\n  \"id\": \"client-supplied-id-must-be-ignored\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"resourceType Patient\", () => pm.expect(pm.response.json().resourceType).to.eql(\"Patient\"));",
                  "const body = pm.response.json();",
                  "pm.test(\"meta.versionId is \\\"1\\\"\", () => pm.expect(body.meta.versionId).to.eql(\"1\"));",
                  "pm.test(\"ETag is W/\\\"1\\\"\", () => pm.expect(pm.response.headers.get(\"ETag\")).to.eql('W/\"1\"'));",
                  "pm.test(\"Location points at the new resource\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/Patient/\" + body.id));",
                  "pm.test(\"client-supplied id is ignored\", () => pm.expect(body.id).to.not.eql(\"client-supplied-id-must-be-ignored\"));",
                  "pm.test(\"server-assigned id is a UUID v4\", () => pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/));",
                  "pm.collectionVariables.set(\"patientId\", body.id);"
                ]
              }
            }
          ],
          "id": "fe3dfff1-2b3e-5e7f-b3e2-8f350a69e0c2"
        },
