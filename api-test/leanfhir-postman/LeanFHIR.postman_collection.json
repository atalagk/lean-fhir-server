    {
      "name": "04-conditional-errors",
      "description": "Conditional create (F3), unresolved reference 422 (F9), invalid structure 422 (F10), delete blocked 409 (F9).",
      "item": [
        {
          "name": "Conditional create, one match (expect 200, nothing written)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/fhir+json"
              },
              {
                "key": "If-None-Exist",
                "value": "identifier=urn:leanfhir:test:mrn|MRN-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Patient",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Patient"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Patient\",\n  \"identifier\": [\n    {\n      \"system\": \"urn:leanfhir:test:mrn\",\n      \"value\": \"MRN-{{runId}}\"\n    }\n  ],\n  \"name\": [\n    {\n      \"family\": \"ShouldNotBeCreated\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"resourceType Patient\", () => pm.expect(pm.response.json().resourceType).to.eql(\"Patient\"));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns the existing patient unchanged\", () => {",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get(\"patientId\"));",
                  "  pm.expect(body.meta.versionId).to.eql(\"2\");",
                  "  pm.expect(body.name[0].family).to.eql(\"Smithson\");",
                  "});"
                ]
              }
            }
          ],
          "id": "c16e2e43-a36d-5111-9ce7-fb2df0005d5a"
        },
