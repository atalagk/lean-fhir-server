meta {
  name: Encounter with unresolved subject (expect 422)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/Encounter
  body: json
  auth: none
}

headers {
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Encounter",
    "status": "planned",
    "class": {
      "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode",
      "code": "AMB"
    },
    "subject": { "reference": "Patient/does-not-exist-{{runId}}" }
  }
}

assert {
  res.status: eq 422
  res.body.resourceType: eq OperationOutcome
}
