meta {
  name: Create Organization
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/Organization
  body: json
  auth: none
}

headers {
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Organization",
    "identifier": [
      { "system": "urn:leanfhir:test:org", "value": "ORG-{{runId}}" }
    ],
    "active": true,
    "name": "Test Clinic {{runId}}"
  }
}

assert {
  res.status: eq 201
  res.body.resourceType: eq Organization
  res.body.meta.versionId: eq "1"
}

script:pre-request {
  // New run id per run: keeps identifiers unique so data from earlier runs
  // does not affect the conditional-create and search checks.
  bru.setVar("runId", String(Date.now()));
}

script:post-response {
  bru.setVar("orgId", res.getBody().id);
}

tests {
  test("ETag is version 1", function () {
    expect(res.getHeader("etag")).to.equal('W/"1"');
  });
  test("Location header points at the new resource", function () {
    expect(res.getHeader("location")).to.contain("/Organization/" + res.getBody().id);
  });
}
